{
  "name": "iobroker.yahoo-stock-market",
  "version": "0.0.8",
  "description": "ioBroker adapter to check stock market using yahoo-finance2 v3",
  "author": {
    "name": "Newan",
    "email": "info@newan.de"
  },
  "homepage": "https://github.com/Newan/ioBroker.yahoo-stock-market",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "stock-market",
    "yahoo-finance",
    "stocks",
    "adapter"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Newan/ioBroker.yahoo-stock-market.git"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.2.2",
    "yahoo-finance2": "^3.11.2"
  },
  "devDependencies": {
    "@iobroker/adapter-dev": "^1.3.0",
    "@iobroker/testing": "^5.0.0",
    "@tsconfig/node16": "^16.1.3",
    "@types/chai": "^4.3.20",
    "@types/chai-as-promised": "^7.1.8",
    "@types/mocha": "^10.0.9",
    "@types/node": "^16.18.108",
    "@types/proxyquire": "^1.3.31",
    "@types/sinon": "^17.0.3",
    "@types/sinon-chai": "^3.2.12",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2",
    "eslint": "^8.57.1",
    "mocha": "^10.8.2",
    "proxyquire": "^2.1.3",
    "sinon": "^19.0.2",
    "sinon-chai": "^3.7.0",
    "typescript": "~5.3.3"
  },
  "main": "build/main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "build/",
    "www/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "rimraf build",
    "build": "build-adapter ts",
    "watch": "build-adapter ts --watch",
    "prebuild:ts": "rimraf build",
    "build:ts": "build-adapter ts",
    "watch:ts": "build-adapter ts --watch",
    "test:ts": "mocha --config test/mocharc.custom.json src/**/*.test.ts",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:ts && npm run test:package",
    "check": "tsc --noEmit",
    "lint": "eslint --ext .ts src/",
    "translate": "translate-adapter",
    "release": "release-script"
  },
  "bugs": {
    "url": "https://github.com/Newan/ioBroker.yahoo-stock-market/issues"
  },
  "readmeFilename": "README.md"
}